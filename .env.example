# Cenato: configurazione di Supabase (RNF_I_5).
# Copia questo file in .env (ignorato da Git) e inserisci i valori del progetto:
# Supabase Dashboard > Project Settings > API.
# Usa SOLO la chiave pubblica "anon" (o "publishable").
# La chiave "service_role" (o "secret") NON va mai nell'app.
SUPABASE_URL=https://tuo-progetto.supabase.co
SUPABASE_ANON_KEY=inserisci-qui-la-chiave-anon
